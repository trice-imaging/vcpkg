diff --git a/dcmdata/tests/tjsonrd.cc b/dcmdata/tests/tjsonrd.cc
new file mode 100644
index 0000000..f08cc0b
--- /dev/null
+++ b/dcmdata/tests/tjsonrd.cc
@@ -0,0 +1,88 @@
+#include "dcmtk/config/osconfig.h"
+#include "dcmtk/dcmdata/dctk.h"
+#include "dcmtk/dcmdata/dcjsonrd.h"
+#include "dcmtk/ofstd/offile.h"
+#include "dcmtk/ofstd/oflimits.h"
+#include "dcmtk/ofstd/oftempf.h"
+#include "dcmtk/ofstd/oftest.h"
+
+static const char jsonDataset[] =
+    "{\"00100010\":{\"vr\":\"PN\",\"Value\":[{\"Alphabetic\":\"M\xc3\xbcller^Jane\"}]},"
+    "\"00400100\":{\"vr\":\"SQ\",\"Value\":[{\"00080060\":{\"vr\":\"CS\",\"Value\":[\"US\"]}}]},"
+    "\"00420011\":{\"vr\":\"OB\",\"InlineBinary\":\"AQIDBA==\"}}";
+
+OFTEST(dcmdata_jsonReader_buffer)
+{
+    DcmJSONReader reader;
+    DcmFileFormat fileformat;
+    // Read only the specified span, with no null terminator at its boundary.
+    const OFString input = OFString(jsonDataset) + "not JSON";
+    OFCHECK(reader.readAndConvertJSONBuffer(fileformat, input.data(), sizeof(jsonDataset) - 1).good());
+    OFCHECK_EQUAL(input, OFString(jsonDataset) + "not JSON");
+    OFString name;
+    OFCHECK(fileformat.getDataset()->findAndGetOFStringArray(DCM_PatientName, name).good());
+    OFCHECK_EQUAL(name, "M\xc3\xbcller^Jane");
+    DcmItem *step = NULL;
+    OFCHECK(fileformat.getDataset()->findAndGetSequenceItem(DCM_ScheduledProcedureStepSequence, step).good());
+    if (step)
+    {
+        OFString modality;
+        OFCHECK(step->findAndGetOFString(DCM_Modality, modality).good());
+        OFCHECK_EQUAL(modality, "US");
+    }
+    const Uint8 *bytes = NULL;
+    unsigned long count = 0;
+    OFCHECK(fileformat.getDataset()->findAndGetUint8Array(DCM_EncapsulatedDocument, bytes, &count).good());
+    OFCHECK_EQUAL(count, 4);
+    if (bytes && count == 4)
+        OFCHECK(memcmp(bytes, "\x01\x02\x03\x04", 4) == 0);
+}
+
+OFTEST(dcmdata_jsonReader_fileAndBuffer)
+{
+    OFTempFile tempfile;
+    OFCHECK(tempfile.getStatus().good());
+    OFFile output;
+    OFCHECK(output.fopen(tempfile.getFilename(), "wb"));
+    if (!output.open()) return;
+    OFCHECK_EQUAL(output.fwrite(jsonDataset, 1, sizeof(jsonDataset) - 1), sizeof(jsonDataset) - 1);
+    OFCHECK_EQUAL(output.fclose(), 0);
+
+    DcmJSONReader reader;
+    DcmFileFormat fromFile;
+    DcmFileFormat fromBuffer;
+    OFCHECK(reader.readAndConvertJSONFile(fromFile, tempfile.getFilename()).good());
+    OFCHECK(reader.readAndConvertJSONBuffer(fromBuffer, jsonDataset, sizeof(jsonDataset) - 1).good());
+    OFCHECK_EQUAL(fromFile.getDataset()->compare(*fromBuffer.getDataset()), 0);
+}
+
+OFTEST(dcmdata_jsonReader_bufferReuse)
+{
+    const char input[] = "[{\"00100020\":{\"vr\":\"LO\",\"Value\":[\"first\"]}},"
+                         "{\"00100020\":{\"vr\":\"LO\",\"Value\":[\"second\"]}}]";
+    DcmJSONReader reader;
+    DcmFileFormat rejected;
+    OFCHECK(reader.readAndConvertJSONBuffer(rejected, input, sizeof(input) - 1).bad());
+    reader.setArrayHandlingPolicy(2);
+    for (int i = 0; i < 2; ++i)
+    {
+        DcmFileFormat fileformat;
+        OFCHECK(reader.readAndConvertJSONBuffer(fileformat, input, sizeof(input) - 1).good());
+        OFString id;
+        OFCHECK(fileformat.getDataset()->findAndGetOFString(DCM_PatientID, id).good());
+        OFCHECK_EQUAL(id, "second");
+    }
+}
+
+OFTEST(dcmdata_jsonReader_invalidBuffer)
+{
+    DcmJSONReader reader;
+    DcmFileFormat fileformat;
+    OFCHECK(reader.readAndConvertJSONBuffer(fileformat, NULL, 0).bad());
+    OFCHECK(reader.readAndConvertJSONBuffer(fileformat, "", 0).bad());
+    OFCHECK(reader.readAndConvertJSONBuffer(fileformat, "", OFnumeric_limits<size_t>::max()).bad());
+    OFCHECK(reader.readAndConvertJSONBuffer(fileformat, "{", 1).bad());
+    const char invalid[] = "{\"00100020\":{\"vr\":\"LO\",\"Value\":\"not an array\"}}";
+    OFCHECK(reader.readAndConvertJSONBuffer(fileformat, invalid, sizeof(invalid) - 1).bad());
+    OFCHECK(reader.readAndConvertJSONBuffer(fileformat, jsonDataset, sizeof(jsonDataset) - 1).good());
+}
