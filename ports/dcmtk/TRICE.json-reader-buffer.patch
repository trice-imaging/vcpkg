+
+OFCondition DcmJSONReader::readAndConvertJSONBuffer(
+    DcmFileFormat& fileformat,
+    const char *data,
+    size_t length)
+{
+    // Keep policy settings, but discard the previous input and tokens.
+    clear();
+    if ((data == NULL) || (length == OFnumeric_limits<size_t>::max()))
+        return EC_IllegalParameter;
+
+    // Parsing temporarily modifies the buffer when extracting token content.
+    jsonDataset_ = new (std::nothrow) char[length + 1];
+    if (jsonDataset_ == NULL) return EC_MemoryExhausted;
+    memcpy(jsonDataset_, data, length);
+    jsonDataset_[length] = '\0';
+    jsonDatasetLen_ = length;
+
+    return convertJSON(fileformat);
+}
+
+
+OFCondition DcmJSONReader::convertJSON(DcmFileFormat& fileformat)
+{
+    DcmMetaInfo* metaheader = fileformat.getMetaInfo();
+    DcmDataset* dataset = fileformat.getDataset();
